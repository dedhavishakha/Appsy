# The live settings file (live.json) this app loads its design from. `npm run dev` writes the
# real .env for you (scripts/use-dev-design.mjs), because the admin's tunnel address changes
# each time `shopify app dev` restarts. Store builds get the permanent address instead.
EXPO_PUBLIC_SETTINGS_URL=https://example.trycloudflare.com/cdn/a/<app id>/live.json
