{
  "name": "@appsy/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The Appsy runtime: the Expo app every merchant's phone app is built from. It downloads the published settings file and draws the store from it.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/use-dev-design.mjs && expo start",
    "start": "expo start",
    "web": "expo start --web",
    "build:preview": "node scripts/build-preview.mjs",
    "build-identity": "node scripts/fetch-build-identity.mjs",
    "eas-build-pre-install": "node scripts/fetch-build-identity.mjs",
    "licences": "node scripts/write-licences.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@appsy/app-config": "*",
    "@appsy/blocks": "*",
    "@appsy/sections": "*",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jost": "^0.4.2",
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zod": "4.6.5"
